{
    "name": "mozistudios/siat",
    "description": "Cliente independiente para la facturación computarizada en línea del SIN de Bolivia (SIAT V3, IVA transparente).",
    "type": "library",
    "license": "proprietary",
    "version": "0.1.0",
    "keywords": ["siat", "impuestos", "bolivia", "facturacion"],
    "require": {
        "php": "^8.3",
        "ext-bcmath": "*",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-soap": "*",
        "ext-zlib": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "MoziStudios\\Siat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MoziStudios\\Siat\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}

# Plantilla de .env para producción en hosting compartido (docs/DESPLIEGUE_HOSTING_COMPARTIDO.md).
# Copiar como .env en el servidor y completar los valores marcados con <...>. Este archivo no lleva
# secretos: las contraseñas y tokens se escriben solo en el .env del servidor, nunca en Git ni en chats.

APP_NAME=MoziStock
APP_ENV=production
# Se genera en el servidor con: php artisan key:generate
APP_KEY=
APP_DEBUG=false
# Las passkeys quedan atadas a este dominio: no cambiarlo después de que los usuarios las registren.
APP_URL=https://app.mozistock.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
MOZISTOCK_MODE=saas

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Un archivo por día, 14 días; solo avisos y errores (sin datos de depuración).
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Base y usuario creados en el panel del hosting (nunca root). Hosting compartido: suele ser localhost.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<BASE_DE_DATOS>
DB_USERNAME=<USUARIO_DE_LA_BASE>
# Si la contraseña tiene espacios o #, escríbela entre comillas dobles.
DB_PASSWORD=<CONTRASENA_DE_LA_BASE>
# Obligatorio desde la primera migración: sesión MySQL en UTC, igual que la aplicación.
DB_TIMEZONE=+00:00

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=mozistock_session
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie de sesión solo por HTTPS.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Hosting compartido: el cron de cada minuto procesa la cola (no hay queue:work permanente).
MOZISTOCK_COLA_DESDE_CRON=true

# Correo del propio hosting (cuenta creada en el panel). Sin esto nadie puede recuperar su contraseña.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=<SERVIDOR_SMTP>
MAIL_PORT=465
MAIL_USERNAME=no-responder@mozistock.com
MAIL_PASSWORD=<CONTRASENA_DEL_CORREO>
MAIL_FROM_ADDRESS="no-responder@mozistock.com"
MAIL_FROM_NAME="${APP_NAME}"

# Facturación SIAT: mientras no esté certificada, dejar el piloto y no vender el plan con SIAT.
SIAT_CODIGO_SISTEMA=
SIAT_AMBIENTE=2
SIAT_URL_BASE=https://pilotosiatservicios.impuestos.gob.bo/sfd/
SIAT_URL_QR=https://pilotosiat.impuestos.gob.bo/consulta/QR
SIAT_PRUEBAS_NIT=
SIAT_PRUEBAS_TOKEN=

# Catálogo Cyclone: el token también puede guardarse en Superadministración (cifrado).
CYCLONE_API_BASE_URL=https://cyclonelimpieza.com/sistema/api/v1
CYCLONE_API_TOKEN=

# Agente Mozi apagado en el lanzamiento: activarlo solo con la política de privacidad lista (Fase 3).
AGENTE_MOZI_HABILITADO=false
AGENTE_MOZI_MOTOR=demo
AGENTE_MOZI_SANDBOX_WEB=true
AGENTE_MOZI_SANDBOX_IA=false
AGENTE_MOZI_MENSAJES_DIARIOS=100
AGENTE_MOZI_TOKENS_DIARIOS=400000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT=45
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
OPENAI_TIMEOUT=45

VITE_APP_NAME="${APP_NAME}"
